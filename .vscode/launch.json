      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/outDebug.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
