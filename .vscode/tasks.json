{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build CPU (g++)",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}/CPU/main.cpp",
        "${workspaceFolder}/CPU/cpu.cpp",
        "-o",
        "${workspaceFolder}/build/Debug/outDebug.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build GPU (nvcc)",
      "command": "nvcc",
      "args": [
        "-g",
        "-G",
        "${workspaceFolder}/GPU/Other/main.cpp",
        "-o",
        "${workspaceFolder}/build/Debug/outDebug.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
